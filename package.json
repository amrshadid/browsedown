{
  "name": "browsedown",
  "displayName": "Browsedown",
  "description": "Open a Markdown folder or file from VS Code and read it in your browser with GitHub-style rendering and working navigation.",
  "version": "0.3.0",
  "publisher": "browsedown",
  "license": "MIT",
  "preview": true,
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/amrshadid/browsedown.git"
  },
  "bugs": {
    "url": "https://github.com/amrshadid/browsedown/issues"
  },
  "homepage": "https://github.com/amrshadid/browsedown#readme",
  "keywords": [
    "markdown",
    "preview",
    "browser",
    "docs",
    "reader",
    "github"
  ],
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#f5f4ef",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces, git is not run. Folder previews list files by walking the folder and applying only the .gitignore files inside it."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "browsedown.openInBrowser",
        "title": "Open in Browser",
        "category": "Browsedown"
      },
      {
        "command": "browsedown.stopAll",
        "title": "Stop All Previews",
        "category": "Browsedown"
      },
      {
        "command": "browsedown.openAll",
        "title": "Open All in Browser",
        "category": "Browsedown",
        "icon": "$(link-external)"
      },
      {
        "command": "browsedown.refreshDocs",
        "title": "Refresh Docs",
        "category": "Browsedown",
        "icon": "$(refresh)"
      },
      {
        "command": "browsedown.showIgnored",
        "title": "Show Ignored Folders",
        "category": "Browsedown",
        "icon": "$(eye)"
      },
      {
        "command": "browsedown.hideIgnored",
        "title": "Hide Ignored Folders",
        "category": "Browsedown",
        "icon": "$(eye-closed)"
      },
      {
        "command": "browsedown.openDoc",
        "title": "Open in Browser",
        "category": "Browsedown"
      },
      {
        "command": "browsedown.openFolder",
        "title": "Open Folder in Browser",
        "category": "Browsedown",
        "icon": "$(link-external)"
      },
      {
        "command": "browsedown.openInEditor",
        "title": "Open in Editor",
        "category": "Browsedown",
        "icon": "$(go-to-file)"
      },
      {
        "command": "browsedown.openEditor",
        "title": "Open in Browser",
        "category": "Browsedown",
        "icon": "$(link-external)"
      },
      {
        "command": "browsedown.hide",
        "title": "Hide in Browsedown",
        "category": "Browsedown",
        "icon": "$(eye-closed)"
      },
      {
        "command": "browsedown.unhide",
        "title": "Unhide in Browsedown",
        "category": "Browsedown",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "browsedown.openInBrowser",
          "when": "(explorerResourceIsFolder || resourceExtname =~ /^\\.(md|markdown|ya?ml)$/i) && !isWeb && !remoteName",
          "group": "navigation@90"
        },
        {
          "command": "browsedown.hide",
          "when": "(explorerResourceIsFolder || resourceExtname =~ /^\\.(md|markdown|ya?ml)$/i) && !isWeb && !remoteName",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "browsedown.openInBrowser",
          "when": "false"
        },
        {
          "command": "browsedown.stopAll",
          "when": "!isWeb && !remoteName"
        },
        {
          "command": "browsedown.openDoc",
          "when": "false"
        },
        {
          "command": "browsedown.openFolder",
          "when": "false"
        },
        {
          "command": "browsedown.openInEditor",
          "when": "false"
        },
        {
          "command": "browsedown.openAll",
          "when": "!isWeb && !remoteName"
        },
        {
          "command": "browsedown.refreshDocs",
          "when": "!isWeb && !remoteName"
        },
        {
          "command": "browsedown.showIgnored",
          "when": "!isWeb && !remoteName && !browsedown.showIgnored"
        },
        {
          "command": "browsedown.hideIgnored",
          "when": "!isWeb && !remoteName && browsedown.showIgnored"
        },
        {
          "command": "browsedown.openEditor",
          "when": "resourceLangId == markdown && resourceScheme == file && !isWeb && !remoteName"
        },
        {
          "command": "browsedown.hide",
          "when": "resourceScheme == file && !isWeb && !remoteName"
        },
        {
          "command": "browsedown.unhide",
          "when": "!isWeb && !remoteName"
        }
      ],
      "view/title": [
        {
          "command": "browsedown.openAll",
          "when": "view == browsedown.docs",
          "group": "navigation@1"
        },
        {
          "command": "browsedown.showIgnored",
          "when": "view == browsedown.docs && !browsedown.showIgnored",
          "group": "navigation@2"
        },
        {
          "command": "browsedown.hideIgnored",
          "when": "view == browsedown.docs && browsedown.showIgnored",
          "group": "navigation@2"
        },
        {
          "command": "browsedown.refreshDocs",
          "when": "view == browsedown.docs",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "browsedown.openAll",
          "when": "view == browsedown.docs && viewItem == browsedown.workspace",
          "group": "inline"
        },
        {
          "command": "browsedown.openFolder",
          "when": "view == browsedown.docs && viewItem == browsedown.folder",
          "group": "inline"
        },
        {
          "command": "browsedown.openInEditor",
          "when": "view == browsedown.docs && viewItem == browsedown.doc",
          "group": "inline"
        },
        {
          "command": "browsedown.openDoc",
          "when": "view == browsedown.docs && viewItem == browsedown.doc",
          "group": "navigation@1"
        },
        {
          "command": "browsedown.openInEditor",
          "when": "view == browsedown.docs && viewItem == browsedown.doc",
          "group": "navigation@2"
        },
        {
          "command": "browsedown.openFolder",
          "when": "view == browsedown.docs && viewItem == browsedown.folder",
          "group": "navigation@1"
        },
        {
          "command": "browsedown.openAll",
          "when": "view == browsedown.docs && viewItem == browsedown.workspace",
          "group": "navigation@1"
        },
        {
          "command": "browsedown.unhide",
          "when": "view == browsedown.docs && viewItem == browsedown.hidden",
          "group": "inline"
        },
        {
          "command": "browsedown.unhide",
          "when": "view == browsedown.docs && viewItem == browsedown.hidden",
          "group": "navigation@1"
        },
        {
          "command": "browsedown.hide",
          "when": "view == browsedown.docs && (viewItem == browsedown.folder || viewItem == browsedown.doc)",
          "group": "navigation@9"
        }
      ],
      "editor/title": [
        {
          "command": "browsedown.openEditor",
          "when": "resourceLangId == markdown && resourceScheme == file && !isWeb && !remoteName",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "browsedown",
          "title": "Browsedown",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "browsedown": [
        {
          "id": "browsedown.docs",
          "name": "Docs",
          "when": "!isWeb && !remoteName",
          "contextualTitle": "Browsedown"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "browsedown.docs",
        "contents": "Open a folder to list its Markdown docs here and read them in your browser.\n[Open Folder](command:workbench.action.files.openFolder)",
        "when": "workbenchState == empty"
      },
      {
        "view": "browsedown.docs",
        "contents": "No Markdown files found.\nFolders that .gitignore hides are left out. Show them with the eye button above, or right-click a folder in the Explorer and choose Open in Browser.",
        "when": "workbenchState != empty && !browsedown.showIgnored"
      },
      {
        "view": "browsedown.docs",
        "contents": "No Markdown files found, including in ignored folders.",
        "when": "workbenchState != empty && browsedown.showIgnored"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "compile-tests": "tsc -p test/integration/tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/client/tsconfig.json --noEmit && tsc -p test/integration/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && npm run compile-tests && vscode-test --label main",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build:prod"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/hast": "3.0.5",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vitest/coverage-v8": "5.1.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "highlight.js": "11.11.2",
    "ovsx": "1.4.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "github-markdown-css": "5.9.0",
    "ignore": "7.0.14",
    "lowlight": "3.3.0",
    "mermaid": "12.3.0",
    "rehype-highlight": "7.0.2",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-github-blockquote-alert": "2.1.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.2.0"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "glob": "14.0.6",
    "diff": "8.0.4",
    "serialize-javascript": "7.1.4"
  }
}
