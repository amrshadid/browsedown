{
  "compilerOptions": {
    "target": "ES2022",
    // esbuild bundles the extension, and the unified packages are ESM-only, so
    // TypeScript resolves like a bundler instead of like Node's CJS loader.
    // https://www.typescriptlang.org/docs/handbook/modules/reference.html#bundler
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "out"
  },
  "include": ["src", "test/unit", "test/support", "*.config.mts"],
  "exclude": ["src/client"]
}
